# Start in a browser-local practice mode. No external messages or paid API calls.
NEXT_PUBLIC_DEMO_MODE=true
# Real mode: set false, configure all values below, then restart/rebuild.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OWNER_USER_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
APP_URL=http://localhost:3000
CRON_SECRET=
BOT_MODE=echo
# Live FAQ operation: BOT_MODE=faq. Echo is restricted to TEST_LINE_USER_ID.
# FAQ trial with only the developer: BOT_MODE=faq + TEST_USER_ONLY=true. Remove it for real customers.
TEST_USER_ONLY=
TEST_LINE_USER_ID=
AI_MONTHLY_LIMIT=500
AI_USER_DAILY_LIMIT=20
AI_MONTHLY_BUDGET_USD=7
